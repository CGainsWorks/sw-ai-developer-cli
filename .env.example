# Copy to .env and fill in whichever provider you use. .env is gitignored.
# Nothing here is needed for `make demo`, `swai plugins`, `swai price` or --help.

# Default provider: the hosted OpenAI API.
OPENAI_API_KEY=

# Used with `swai --provider compat`: any server that speaks the OpenAI Chat
# Completions format, such as Ollama, vLLM, LM Studio or a hosted gateway. With a
# server on your own machine or network, no code leaves it.
# SWAI_COMPAT_BASE_URL=http://localhost:11434/v1
# SWAI_COMPAT_MODEL=qwen2.5-coder:7b
# Local servers usually need no key. For one that does, set the key here, or
# name the variable that holds it with SWAI_COMPAT_API_KEY_ENV.
# SWAI_COMPAT_API_KEY=
# SWAI_COMPAT_API_KEY_ENV=MY_GATEWAY_KEY

# Optional overrides. The same settings are available in swai.config.json.
# SWAI_PROVIDER=openai
# SWAI_MODEL=gpt-4o
# SWAI_MAX_TOKENS=8192
# SWAI_MAX_USD=1.00
# SWAI_LOG_LEVEL=info
# SWAI_JSON=0
